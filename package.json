{
  "name": "dummy-brawl",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "bot": "tsx scripts/bot.ts",
    "test": "vitest run",
    "check:filelength": "node scripts/checkFileLength.mjs",
    "check:bundle": "node scripts/checkBundle.mjs dist",
    "build:playgama": "npm run build && (python3 scripts/pack_playgama.py || python scripts/pack_playgama.py)",
    "check": "npm run typecheck && npm run check:filelength && npm run test && vite build && npm run check:bundle"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
