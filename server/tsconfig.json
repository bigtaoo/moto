{
  // The collector is checked on its own: it runs in node on our box, not in a browser, so it must not
  // see the DOM globals the game's tsconfig provides -- the whole point of a separate config here.
  // Check it with: npm run typecheck:server
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023"],
    // node runs these files as they are, stripping the types (no build step, no bundler): so the
    // imports carry their real extension, and nothing TS-only that node cannot simply erase --
    // an enum or a parameter property would typecheck here and crash in the container.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["."],
  // The tests run under vitest with its own globals; they are checked by the game's tsconfig instead.
  "exclude": ["**/*.test.ts"]
}
